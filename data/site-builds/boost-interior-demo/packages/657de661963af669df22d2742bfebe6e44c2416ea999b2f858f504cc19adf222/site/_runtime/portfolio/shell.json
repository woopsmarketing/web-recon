abel":"이전 슬라이드","nextLabel":"다음 슬라이드","pauseLabel":"슬라이드 일시정지","playLabel":"슬라이드 재생","slideLabelFormat":"{total}장 중 {n}번째"},"home.intro":{"title":"예쁜 공간보다 생활이 편해지는 공간을 먼저 생각합니다","body":{"paragraphs":["부스트 인테리어는 집을 고치기 전에 그 집에서의 하루를 먼저 여쭤봅니다. 아침에 어디서 옷을 입는지, 장 본 물건은 어디에 두는지, 아이 가방은 어디에 놓이는지에 따라 동선과 수납의 자리가 달라지기 때문입니다.","채광을 가리지 않는 밝은 바탕, 물건마다 자리가 있는 수납, 몇 년이 지나도 질리지 않는 마감을 기준으로 삼습니다. 유행하는 장식은 덜어내고 가족이 실제로 쓰는 공간에 예산을 씁니다."]},"link":{"label":"시공사례 둘러보기","href":"/portfolio"},"media":{"asset":"site-intro","alt":"현관 중문 너머로 거실이 이어지는 화이트톤 아파트"}},"home.projects-a":{"title":"대표 프로젝트","description":{"paragraphs":["수납과 동선을 중심으로 계획한 아파트 리모델링 사례입니다."]},"moreLabel":"전체 프로젝트 보기","previousLabel":"이전 프로젝트","nextLabel":"다음 프로젝트"},"home.projects-b":{"title":"다른 시공사례","description":{"paragraphs":["부분 리모델링부터 입주 전 홈스타일링까지, 범위가 다른 사례도 함께 살펴보세요."]},"moreLabel":"전체 프로젝트 보기","previousLabel":"이전 프로젝트","nextLabel":"다음 프로젝트"},"home.reviews":{"title":"고객 후기","media":{"asset":"site-reviews","alt":""},"previousLabel":"이전 후기","nextLabel":"다음 후기"},"home.image-band":{"media":{"asset":"site-band","alt":"저녁에 간접조명만 켜 둔 거실"}},"site.floating-cta":{"label":"상담 문의"},"portfolio.index":{"title":"시공사례","description":{"paragraphs":["부스트 인테리어가 계획하고 시공한 아파트 사례입니다. 평형과 공사 유형, 스타일로 찾아보세요."]},"heroImage":{"asset":"site-portfolio-hero","alt":"세로 골 패널로 마감한 화이트 주방 벽"},"pageLabel":"페이지","previousLabel":"이전 페이지","nextLabel":"다음 페이지","paginationLabel":"페이지 이동","filterLabel":"필터","searchLabel":"프로젝트 검색","searchPlaceholder":"제목, 지역, 키워드로 검색","typeLabel":"공사 유형","areaLabel":"평형","styleLabel":"스타일","priceLabel":"평당 공사비","sortLabel":"정렬","sortNewest":"최신순","sortOldest":"오래된순","sortAreaDesc":"넓은 평형순","sortAreaAsc":"작은 평형순","sortPriceDesc":"평당 공사비 높은순","sortPriceAsc":"평당 공사비 낮은순","resetLabel":"필터 초기화","resultCountFormat":"프로젝트 {n}건","resultCountFormatOne":"프로젝트 {n}건","emptyTitle":"조건에 맞는 프로젝트가 없습니다","emptyBody":"필터를 줄이거나 다른 검색어로 다시 찾아보세요."},"portfolio.detail":{"backLabel":"시공사례 목록으로","roomsLabel":"공간","beforeLabel":"공사 전","afterLabel":"공사 후","showMoreLabel":"사진 모두 보기","showLessLabel":"사진 접기","previousPhotoLabel":"이전 사진","nextPhotoLabel":"다음 사진","allRoomsLabel":"전체","openPhotoLabel":"사진 크게 보기","closeViewerLabel":"닫기","bodyTitle":"프로젝트 이야기","quoteTitle":"고객 한마디","locationLabel":"지역","areaLabel":"면적","areaSupplyLabel":"공급면적","areaExclusiveLabel":"전용면적","projectTypeLabel":"리모델링 구분","workScopesLabel":"주요 공사 범위","totalPriceLabel":"총 공사비","categoryLabel":"공사 유형","builtYearLabel":"준공 연도","scopeLabel":"공사 범위","periodLabel":"공사 시기","durationLabel":"공사 기간","durationFormat":"{n}주","durationFormatOne":"{n}주","keywordsLabel":"스타일","priceLabel":"평당 공사비","ctaPrompt":"비슷한 공사를 계획하고 계신가요?","ctaLabel":"상담 문의하기"},"site.not-found":{"title":"페이지를 찾을 수 없습니다","message":"찾으시는 페이지가 없거나 주소가 바뀌었습니다.","homeLabel":"홈으로 돌아가기"},"site.footer":{"companyLabel":"상호","emailLabel":"이메일","notice":"부스트 인테리어는 BoostInterior 기능 시연을 위한 가상 인테리어 브랜드입니다. 시공사례·후기는 데모용 예시이고, 사진은 AI로 생성한 예시 이미지입니다."},"about.page":{"title":"소개","lead":{"paragraphs":["부스트 인테리어는 보기 좋은 집보다 오래 편하게 사는 집을 먼저 생각합니다. 그 집에서 실제로 살아갈 가족의 하루를 기준으로 동선과 수납, 빛을 설계합니다."]},"body":{"paragraphs":["공사는 도면보다 대화에서 시작합니다. 아침 준비는 어디에서 하는지, 장 본 물건과 아이 가방은 어디에 놓이는지, 가족이 가장 오래 머무는 곳은 어디인지부터 여쭤봅니다. 같은 34평이라도 사는 방식이 다르면 필요한 공간도 달라지기 때문입니다.","그래서 유행하는 장식보다 매일 손이 닿는 곳에 예산을 씁니다. 문이 열리는 방향, 스위치와 콘센트의 위치, 수납장 한 칸의 깊이처럼 살면서 비로소 느껴지는 부분을 먼저 정리합니다."]},"media":{"asset":"site-hero-02","alt":"조명을 넣은 오크 니치가 있는 화이트 붙박이 수납장"},"pointsTitle":"공간을 설계하는 다섯 가지 기준","point1Title":"생활 동선","point1Body":"현관에서 주방, 세탁실에서 드레스룸까지 매일 반복되는 움직임을 짧고 자연스럽게 잇습니다.","point2Title":"수납","point2Body":"물건마다 제자리를 먼저 정합니다. 보이는 곳은 비우고, 필요한 곳에 알맞은 깊이의 수납을 둡니다.","point3Title":"채광","point3Body":"빛을 가리는 벽과 가구를 덜어내고, 밝은 바탕과 간접조명으로 낮에도 밤에도 편안한 밝기를 만듭니다.","point4Title":"오래 편안한 공간","point4Body":"몇 년이 지나도 질리지 않는 마감과 관리하기 쉬운 자재를 고릅니다.","point5Title":"실거주 중심","point5Body":"사진 속 모습보다 실제로 살아갈 가족의 생활을 기준으로 공사 범위와 예산을 제안합니다.","ctaPrompt":"우리 집에 맞는 공사 범위가 궁금하신가요?","ctaLabel":"견적 문의하기","portfolioLabel":"시공사례 보기"},"portfolio3d.page":{"title":"3D 시공사례","body":"공간을 더 입체적으로 확인할 수 있는 3D 시공사례를 준비하고 있습니다.","portfolioLabel":"시공사례 보기"},"contact.page":{"title":"견적 문의","lead":{"paragraphs":["평형과 공사 범위, 원하시는 일정을 알려 주시면 내용을 확인한 뒤 상담을 이어갈 수 있습니다."]},"nameLabel":"이름","phoneLabel":"연락처","regionLabel":"지역","areaLabel":"평형","workTypeLabel":"공사 유형","workTypeOptions":{"paragraphs":["전체 리모델링","부분 리모델링","주방·욕실 리뉴얼","입주 전 홈스타일링","기타"]},"selectPlaceholder":"선택해 주세요","scheduleLabel":"예상 일정","messageLabel":"문의 내용","requiredNote":"* 표시는 필수 항목입니다.","submitLabel":"견적 문의 보내기","notice":"이 페이지는 BoostInterior 기능 시연용입니다.","emailLabel":"이메일","consentLabel":"개인정보 수집·이용에 동의합니다. (수집: 이름·연락처·입력한 문의 내용 / 이용: BoostInterior 시연 문의 확인 / 보관: 접수 후 90일 / 동의하지 않으면 접수되지 않습니다.)","phoneHint":"숫자 8자리 이상으로 입력해 주세요. (예: 010-1234-5678)","noScriptText":"문의 접수에는 JavaScript가 필요합니다. 이메일로 문의해 주세요.","submittingLabel":"접수 중…","successTitle":"견적 문의가 접수되었습니다.","successBody":"입력해주신 내용을 확인한 뒤 상담을 이어갈 수 있습니다.","failureText":"문의 접수 중 문제가 발생했습니다. 잠시 후 다시 시도해주세요.","messagePrefix":"[홈페이지 견적 문의]","invalidText":"입력하신 내용을 다시 확인해 주세요.","conflictText":"문의 내용이 변경되었습니다. 다시 보내 주세요.","rateLimitedText":"요청이 많아 잠시 접수가 어렵습니다. 약 {minutes}분 후 다시 시도해 주세요.","capacityText":"지금은 온라인 문의 접수가 일시적으로 어렵습니다. 나중에 다시 시도해 주세요.","fallbackLead":"다른 방법으로 문의하실 수 있습니다."}}},"headScripts":{"schemaVersion":1,"headScripts":[{"id":"boostchat-widget","src":"https://boostchat.co.kr/widget.js","attrs":{"data-boost-chat-key":"wgt_99kYYFOm7ABvdQbVh_8SdrnOlLrPqDI3"}}]},"inquiry":{"schemaVersion":1,"endpoint":"https://boostchat.co.kr/api/widget/wgt_99kYYFOm7ABvdQbVh_8SdrnOlLrPqDI3/lead"},"content":{"business":{"summary":"생활에 맞춘 설계로 더 편안하고 정돈된 집을 만듭니다. 화이트톤 아파트 리모델링과 실거주 중심의 수납과 동선 설계를 합니다.","contact":{"email":"vnfm0580@gmail.com"}},"projects":[],"categories":[],"reviews":[{"id":"rv-white-care","status":"published","text":"화이트 인테리어는 관리가 어렵다고 들어서 망설였는데, 오염에 강한 마감재부터 제안해 주셔서 마음 놓고 결정했습니다. 살아 보니 청소가 오히려 쉬워요.","attribution":"34평 아파트 · 4인 가족"},{"id":"rv-kitchen-flow","status":"published","text":"주방 동선을 다시 짜 주신 덕분에 요리할 때 걷는 걸음이 확 줄었어요. 도면으로 동선을 미리 보여 주셔서 이해하기 쉬웠습니다.","attribution":"29평 아파트 · 맞벌이 부부"},{"id":"rv-entrance-bench","status":"published","text":"현관에 벤치와 수납을 만든 뒤로 아이들 가방과 신발이 거실까지 들어오지 않아요. 작은 변화인데 매일 체감합니다.","attribution":"42평 아파트 · 5인 가족"},{"id":"rv-budget-priority","status":"published","text":"예산 안에서 꼭 해야 할 공사와 나중에 해도 되는 공사를 나눠 설명해 주신 점이 좋았습니다. 덕분에 욕실과 주방에 집중할 수 있었어요.","attribution":"32평 아파트 · 3인 가족"},{"id":"rv-small-home","status":"published","text":"작은 평수라 기대가 크지 않았는데, 붙박이장에 짐을 다 넣고 나니 거실이 이렇게 넓었나 싶어요.","attribution":"19평 아파트 · 1인 가구"},{"id":"rv-progress-share","status":"published","text":"공사 중간중간 사진과 함께 진행 상황을 알려 주셔서 직접 가 보지 못하는 날에도 안심이 됐습니다.","attribution":"24평 아파트 · 신혼부부"}],"banners":[{"id":"hero-living","status":"published","image":{"asset":"site-hero-01","alt":"우물천장 간접조명이 켜진 화이트톤 거실 전경"},"headline":"생활에 맞춘 설계, 오래 편안한 집","text":"화이트톤 아파트 리모델링과 실거주 중심의 수납과 동선을 설계합니다.","cta":{"label":"대표 프로젝트 보기","target":{"kind":"project","project":"bi-01"}}},{"id":"hero-storage","status":"published","image":{"asset":"site-hero-02","alt":"조명을 넣은 오크 니치가 있는 화이트 붙박이 수납장"},"headline":"수납이 정리되면 집이 넓어집니다","text":"현관부터 주방까지, 물건의 자리를 먼저 정하고 공간을 계획합니다.","cta":{"label":"수납 중심 리모델링 보기","target":{"kind":"project","project":"bi-03"}}},{"id":"hero-consult","status":"published","image":{"asset":"site-hero-03","alt":"키큰장과 일자 싱크대가 마주 보는 화이트 주방"},"headline":"우리 집에 맞는 공사 범위가 궁금하다면","text":"평형과 고민을 알려 주시면 필요한 공사부터 차근차근 안내해 드립니다.","cta":{"label":"상담 문의","target":{"kind":"contact"}}}]},"assets":[{"id":"logo","file":"logo.svg","mediaType":"image/svg+xml","width":188,"height":32,"sha256":"f7fc7d18036335e53d7b8e0728ebb24b4f7130b2e93ae987c84ef52ae468688b","publicPath":"/assets/f7fc7d18036335e53d7b.svg"},{"id":"site-band","file":"site-band.jpg","mediaType":"image/jpeg","width":2400,"height":950,"sha256":"7ec4f2edabb354feed2baec3ed6e77d960d692941b5ebdff9daa8708678b0619","publicPath":"/assets/7ec4f2edabb354feed2b.jpg"},{"id":"site-hero-01","file":"site-hero-01.jpg","mediaType":"image/jpeg","width":2400,"height":1350