{
  "schemaVersion": 1,
  "templateId": "interior-03",
  "overrides": {
    "site.seo": {
      "indexing": "noindex"
    },
    "site.floater": {
      "toTop": true,
      "externalWidget": {
        "width": 64,
        "height": 64,
        "right": 18,
        "bottom": 18
      }
    },
    "home.band": {
      "enabled": true,
      "icons": ["estimate", "notice", "company", "chat"]
    },
    "home.portfolio": {
      "enabled": true,
      "limit": 6,
      "selection": {
        "mode": "manual",
        "ids": ["bi-01", "bi-03", "bi-02", "bi-04", "bi-06", "bi-08"]
      }
    },
    "portfolio.detail": {
      "facts": true,
      "groupLabels": true
    }
  }
}
