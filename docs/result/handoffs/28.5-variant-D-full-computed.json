    "symptomAfterRepair": {
      "r000008 baseline changedRatio": 0.0025,
      "r000007 baseline changedRatio": 0.0003,
      "heightDelta": 0
    },
    "generality": "Not linear.app-specific. Any CSS-in-JS runtime in production mode (styled-components speedy, emotion, stitches) is invisible to DOM serialisation. Any snapshot-based reconstruction must read document.styleSheets, not the DOM."
  },
