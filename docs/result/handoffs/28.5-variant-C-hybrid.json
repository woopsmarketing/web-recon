  "criticalMechanismFinding": {
    "name": "CSSOM_ONLY_STYLESHEET_LOSS",
    "statement": "document.documentElement.outerHTML does NOT carry rules inserted through CSSOM insertRule(). linear.app uses styled-components 6.1.24; its <style data-styled=\"active\"> element serialises with an EMPTY text node. Any 'snapshot the DOM plus the linked stylesheets' strategy silently drops every styled-component rule, including the rule that sizes the <h1> on /security.",
    "measured": {
      "routes": {
        "r000008": {
          "cssomOnlyRules": 61,
          "cssomOnlyBytes": 7202,
          "bytesCarriedByOuterHTML": 0
        },
        "r000007": {
          "cssomOnlyRules": 78,
          "cssomOnlyBytes": 9490,
          "bytesCarriedByOuterHTML": 0
        }
      }
    },
    "ablation": "variant C0 (identical build, CSSOM harvest disabled): changedRatio 0.0474-0.1273 and scrollHeight off by up to +281px, versus 0.0002-0.0025 and 0px with the harvest. 20x-300x worse.",
    "genericFix": "harvest every stylesheet whose ownerNode serialises EMPTY but whose CSSOM has rules, and refill those <style> elements in place (preserves cascade position). No library or site knowledge required — the implemented rule names neither styled-components nor linear.app."
  },
