// recon-runtime — serves published Site Build Packages from R2 (see src/index.ts).
// Source of truth for the Worker's Cloudflare configuration.
//
// Default (no --env): NO routes, NO custom domains, workers.dev and preview URLs OFF, so
// `wrangler deploy` of this config alone would expose nothing. A hostname is attached only by
// the explicit `pilot` environment below, whose single exact route went live on 2026-09-22
// (docs/result/cloudflare-live-pilot/; plan: docs/result/static-deployment-foundation/07-live-deploy-plan.md).
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "recon-runtime",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-15",
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },
  // The Worker logs one JSON line per response with status >= 400 (src/index.ts). To log every
  // response while diagnosing, add to the environment in use:  "vars": { "LOG_ALL": "1" }
  "r2_buckets": [
    { "binding": "SITES", "bucket_name": "boost-sites-artifacts" }
  ],
  "env": {
    "pilot": {
      "name": "recon-runtime-pilot",
      "workers_dev": false,
      "preview_urls": false,
      "r2_buckets": [
        { "binding": "SITES", "bucket_name": "boost-sites-artifacts" }
      ]
      // Exact-hostname pilot attachment — enable ONLY during the live run (07-live-deploy-plan.md).
      // Pick ONE form. Never a wildcard, never a pattern that an existing Worker already serves.
      //
      // (a) The zone has NO Worker route that matches the pilot hostname → Workers Custom Domain
      //     (Cloudflare creates the proxied DNS record and the certificate):
      // ,"routes": [ { "pattern": "<pilot-hostname>", "custom_domain": true } ]
      //
      // (b) The zone HAS a route that matches it (e.g. a wildcard "*.<zone>/*" owned by another
      //     product): a Custom Domain Worker is treated as an ORIGIN and that route's Worker would
      //     run first. Use an exact route instead — the most specific pattern wins — and create a
      //     proxied DNS record for the hostname by hand:
      // ,"routes": [ { "pattern": "<pilot-hostname>/*", "zone_name": "<zone>" } ]
      //
      // LIVE since 2026-09-22 (docs/result/cloudflare-live-pilot/): form (b). boostweb.co.kr carries
      // "*.boostweb.co.kr/*" and "*/*" → site-factory-next; this exact route wins over both. No DNS
      // record was created: the zone's existing proxied wildcard "*.boostweb.co.kr" AAAA 100:: covers it.
      //
      // 2026-10-09: second exact route for the interior-02 demo (docs/result/interior-02-reuse-boostinterior/
      // 05-production-demo-02.md), same form (b) and the same wildcard DNS record. `wrangler deploy` PUTs the
      // whole list, so every live hostname must stay in this array.
      //
      // 2026-10-09: third exact route for the interior-03 demo (docs/result/interior-03-dagamhome-e2e/
      // 05-boostchat-and-domain.md), same form (b), same wildcard DNS record.
      //
      // ┌─ THIS ARRAY IS NO LONGER THE WHOLE LIST ───────────────────────────────────────────────────┐
      // Since hosted site provisioning (platform/provision/, .github/workflows/provision-site.yml),
      // one exact route per NEW hostname is created through the Cloudflare API
      // (POST zones/<zone>/workers/routes → this script) and is NOT written back to this file.
      //
      // `wrangler deploy --env pilot` from this file is therefore FORBIDDEN: wrangler replaces the
      // Worker's whole route list with the array below, and every provisioned site would go off the
      // air without an error. Deploy this Worker ONLY with
      //
      //     tsx --tsconfig platform/tsconfig.json platform/cli/runtime-deploy.ts [--dry-run]
      //
      // which lists the zone's live routes of this script, merges them with this array, refuses when
      // the list cannot be read, and deploys from the merged list. The array below stays as the seed
      // (the hostnames attached by hand) and must keep the form { pattern, zone_name } with ONE zone.
      // └────────────────────────────────────────────────────────────────────────────────────────────┘
      ,"routes": [
        { "pattern": "interior-demo.boostweb.co.kr/*", "zone_name": "boostweb.co.kr" },
        { "pattern": "interior-demo-2.boostweb.co.kr/*", "zone_name": "boostweb.co.kr" },
        { "pattern": "interior-demo-3.boostweb.co.kr/*", "zone_name": "boostweb.co.kr" }
      ]
    }
  }
}
